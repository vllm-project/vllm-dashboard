# Copy to ~/.config/vllm-triage/extractor.env and chmod 600.
# Restricted role from extractor-role.sql; never the owner/worker URL.
DATABASE_URL=postgres://triage_extractor.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# Claude Code model alias for extraction.
TRIAGE_MODEL=sonnet
# Our own ceiling, kept under the plan's weekly cap (see README.md).
TRIAGE_MAX_ITEMS_PER_RUN=25
TRIAGE_MAX_ITEMS_PER_DAY=150
TRIAGE_MAX_TOKENS_PER_DAY=1500000
# Optional: a long-lived plan token from `claude setup-token`, so the
# extractor keeps working when the interactive login expires.
# CLAUDE_CODE_OAUTH_TOKEN=
