[Unit]
Description=Report failed alerting unit %i to Slack

[Service]
Type=oneshot
User=alerting
Group=alerting
ExecStart=/opt/alerting/bin/notify-failure %i
StandardOutput=null
# Not inherited from StandardOutput: a notifier that fails silently is
# worse than no notifier. Its stderr carries no secrets.
StandardError=journal
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true
