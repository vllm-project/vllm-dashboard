[Unit]
Description=Retry pending Full CI analyses between scheduled ticks
After=network-online.target
Wants=network-online.target
OnFailure=alerting-failure-notify@%n.service
OnSuccess=alerting-failure-resolve@%n.service

[Service]
Type=oneshot
User=alerting
Group=alerting
# Skip this tick while the scheduled twice-daily run is still working: its
# analyze phase already drains pending comparisons, and concurrent runs
# duplicate LLM work. The next :43 tick checks again. A running oneshot is
# `activating`, never `active`, so match ActiveState; ExecCondition makes the
# skip a no-op instead of a failure that fires OnFailure's Slack alert.
ExecCondition=/bin/bash -c '! systemctl show alerting-full-ci.service -p ActiveState --value | grep -qxE "active|activating|deactivating|reloading"'
ExecStart=/opt/alerting/bin/run-worker full-ci-analyze
StandardOutput=null
StandardError=null
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
TimeoutStartSec=infinity
