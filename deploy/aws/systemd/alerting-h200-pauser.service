[Unit]
Description=Pause the Buildkite agents of quarantined H200 hosts
After=network-online.target
Wants=network-online.target
OnFailure=alerting-failure-notify@%n.service
OnSuccess=alerting-failure-resolve@%n.service

[Service]
Type=oneshot
User=alerting
Group=alerting
# Roll out with --dry-run first; drop it when the pool goes live.
ExecStart=/opt/alerting/bin/run-h200-pauser --dry-run
# It prints hosts, agent names and posts, never a token.
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# ProtectSystem=strict mounts /run read-only; load-secrets writes the
# credential file there and a failed run leaves its error in failures/.
ReadWritePaths=/run/alerting
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
TimeoutStartSec=5min
