[Unit]
Description=Publish the shard timings snapshot CI builds plan from
After=network-online.target
Wants=network-online.target
OnFailure=alerting-failure-notify@%n.service
OnSuccess=alerting-failure-resolve@%n.service

[Service]
Type=oneshot
User=alerting
Group=alerting
ExecStart=/opt/alerting/bin/run-timings-snapshot
StandardOutput=null
StandardError=null
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# load-secrets writes the credential file, and failures are recorded, here.
ReadWritePaths=/run/alerting
# Fetching stops at 40 min (FETCH_BUDGET_SECONDS) and publishes what it has.
TimeoutStartSec=50min
