[Unit]
Description=Apply S3 controls for vLLM alerting paths
After=network-online.target
Wants=network-online.target
OnFailure=alerting-failure-notify@%n.service
OnSuccess=alerting-failure-resolve@%n.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/alerting/worker.env
ExecStart=/opt/alerting/venv/bin/python -m alerting.control --bucket ${ALERTING_CHECKPOINT_BUCKET}
StandardOutput=null
StandardError=null
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
TimeoutStartSec=2min
