#!/usr/bin/env python3
"""Render a Secrets Manager JSON response as safely quoted shell assignments."""

import json
import re
import shlex
import sys


ENVIRONMENT_NAME = re.compile(r"[A-Z_][A-Z0-9_]*\Z")


def main() -> None:
    response = json.load(sys.stdin)
    secret = json.loads(response["SecretString"])
    if not isinstance(secret, dict):
        raise ValueError("secret must contain a JSON object")

    # Skip a bad entry instead of refusing the whole secret. Every unit, the
    # failure notifier included, loads this secret, so on 2026-10-12 one key
    # saved as `BUILDKITE_WRITE_TOKEN,` stopped every alert for 27 hours with
    # nothing reported. A unit that needs the skipped key still fails, and
    # the notifier can now say so.
    for name, value in secret.items():
        if not isinstance(name, str) or ENVIRONMENT_NAME.fullmatch(name) is None:
            # The name is not printed: a malformed key may be a pasted value.
            print("render-secret-env: skipping a key that is not a valid environment variable name", file=sys.stderr)
            continue
        if not isinstance(value, (str, int, float, bool)):
            print(f"render-secret-env: skipping {name}: value must be scalar", file=sys.stderr)
            continue
        print(f"{name}={shlex.quote(str(value))}")


if __name__ == "__main__":
    main()
