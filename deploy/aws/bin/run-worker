#!/bin/bash
set -euo pipefail

consumer=$1
credentials_path="/run/alerting/${consumer}.env"
case "$consumer" in
  fast-ci) alert_path=fast-ci ;;
  full-ci|full-ci-analyze) alert_path=full-ci ;;
  main-ci|main-ci-analyze) alert_path=main-ci ;;
  *) echo "unknown consumer: $consumer" >&2; exit 2 ;;
esac
mode_path="/run/alerting/${alert_path}.mode"

cleanup() {
  rm -f "$credentials_path"
}
trap cleanup EXIT HUP INT TERM

/opt/alerting/bin/load-secrets "$credentials_path"
set -a
# Generated from validated Secrets Manager JSON.
# shellcheck disable=SC1091
source /etc/alerting/worker.env
# Generated from validated Secrets Manager JSON.
# shellcheck disable=SC1090
source "$credentials_path"
if [ -r "$mode_path" ]; then
  # Generated from validated S3 control state.
  # shellcheck disable=SC1090
  source "$mode_path"
else
  export ALERTING_DELIVERY_MODE=shadow
fi
set +a
export BUILDKITE_API_TOKEN="${BUILDKITE_TOKEN:-}"
export HOME=/run/alerting/home
install -d -m 0700 "$HOME"
rm -f "$credentials_path"
trap - EXIT HUP INT TERM

exec /opt/alerting/venv/bin/python -m alerting.worker "$consumer"
