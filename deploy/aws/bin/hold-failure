#!/usr/bin/env python3
"""Decide whether a failed unit's timeout waits before it reaches Slack.

usage: hold-failure <unit> <failure file> <episode state file>
Exit 0: hold this failure (the episode's start and count are recorded in the
state file, which then has no "ts"). Exit 1: post or update the message now.

The database's disk saturates for about 20 minutes every morning, and the
frequent scans time out once or twice and pass on the next run; each blip
posted and resolved its own alert. A timeout of a frequent unit now posts only
once the unit has kept failing for 10 minutes; a run holds only when every
error it recorded is a timeout. Anything else posts at once:
another error, a daily unit (which would otherwise wait a day), or an episode
whose message is already open.
"""

import json
import os
import sys
import time
from datetime import datetime, timezone

HOLD_SECONDS = 600
# Units that run at least every 5 minutes, so a held timeout either clears or
# posts within the hold.
HOLD_UNITS = {
    "alerting-infra.service",
    "alerting-main-ci.service",
    "alerting-h200-pauser.service",
}
TIMEOUTS = (
    "canceling statement due to statement timeout",
    "The read operation timed out",
)

unit, failure_file, state_path = sys.argv[1:4]
now = float(os.environ.get("HOLD_FAILURE_NOW") or time.time())
try:
    with open(state_path) as f:
        state = json.load(f)
except (OSError, ValueError):
    state = {}
try:
    with open(failure_file) as f:
        # The first line is the run id; each further line is one error (the
        # H200 pauser writes one per failed host).
        errors = [line for line in f.read().split("\n")[1:] if line.strip()]
except OSError:
    errors = []

since_epoch = float(state.get("since_epoch", now))
if (
    "ts" in state
    or unit not in HOLD_UNITS
    or not errors
    or not all(any(timeout in error for timeout in TIMEOUTS) for error in errors)
    or now - since_epoch >= HOLD_SECONDS
):
    sys.exit(1)

with open(state_path, "w") as f:
    json.dump(
        {
            "since": state.get("since")
            or datetime.fromtimestamp(now, timezone.utc).strftime("%Y-%m-%d %H:%M UTC"),
            "since_epoch": since_epoch,
            "count": int(state.get("count", 0)) + 1,
        },
        f,
    )
sys.exit(0)
