#!/bin/bash
# Report a failed alerting unit to Slack, straight from systemd's OnFailure=.
#
# This deliberately does not touch Postgres. The outage that stops the
# pipelines is usually the one that takes the database with it, and on
# 2026-09-14 every timer failed for seven hours with nothing recorded anywhere
# because recording itself needs the database that was down.
set -euo pipefail

unit=${1:?usage: notify-failure <unit>}
stamp_dir=/run/alerting/failure-notified
stamp="${stamp_dir}/${unit}"

install -d -m 0700 "$stamp_dir"

credentials_path=/run/alerting/notify-failure.env
cleanup() { rm -f "$credentials_path"; }
trap cleanup EXIT HUP INT TERM
/opt/alerting/bin/load-secrets "$credentials_path"
set -a
# Generated from validated Secrets Manager JSON.
# shellcheck disable=SC1091
source /etc/alerting/worker.env
# shellcheck disable=SC1090
source "$credentials_path"
set +a
rm -f "$credentials_path"
trap - EXIT HUP INT TERM

# One message per unit per window, so a multi-hour outage across timers that
# fire every two minutes does not turn into hundreds of notifications.
throttle=${ALERTING_FAILURE_THROTTLE_SECONDS:-1800}
if [ -f "$stamp" ] && [ "$(( $(date +%s) - $(stat -c %Y "$stamp") ))" -lt "$throttle" ]; then
  exit 0
fi

destination=${ALERTING_FAILURE_SLACK_DESTINATION:-${SLACK_CHANNEL_ID:-}}
if [ -z "$destination" ]; then
  echo "ALERTING_FAILURE_SLACK_DESTINATION is not set" >&2
  exit 1
fi

result=$(systemctl show "$unit" -p Result --value || echo unknown)
status=$(systemctl show "$unit" -p ExecMainStatus --value || echo '?')
log=$(journalctl -u "$unit" -n 4 --no-pager -o cat 2>/dev/null || true)

/opt/alerting/venv/bin/python - "$destination" "$unit" "$result" "$status" "$log" <<'PY' > /run/alerting/notify-failure.json
import json, sys
destination, unit, result, status, log = sys.argv[1:6]
text = (
    f":rotating_light: *Alerting worker failure*\n"
    f"unit `{unit}` — result `{result}`, exit `{status}`\n"
)
if log.strip():
    text += "```" + log.strip()[-800:] + "```\n"
text += (
    "Errors normally land in `alerting_automation_executions.last_error`; "
    "if that table is unreachable the database itself is the failure. "
    "Runbook: vLLM CI Alerting — Operations Handbook."
)
print(json.dumps({"channel": destination, "text": text}))
PY

response=$(curl -sS -X POST https://slack.com/api/chat.postMessage \
  -H "Authorization: Bearer ${SLACK_BOT_TOKEN}" \
  -H "Content-type: application/json; charset=utf-8" \
  --data @/run/alerting/notify-failure.json)
rm -f /run/alerting/notify-failure.json

case "$response" in
  *'"ok":true'*) touch "$stamp" ;;
  *) echo "Slack rejected the failure notification: $response" >&2; exit 1 ;;
esac
