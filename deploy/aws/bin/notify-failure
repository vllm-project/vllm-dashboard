#!/bin/bash
# Report a failed alerting unit to Slack, straight from systemd's OnFailure= —
# and, invoked as `notify-failure --resolve` from OnSuccess=, edit that open
# message in place once the unit succeeds again instead of posting a new one.
#
# This deliberately does not touch Postgres. The outage that stops the
# pipelines is usually the one that takes the database with it, and on
# 2026-09-14 every timer failed for seven hours with nothing recorded anywhere
# because recording itself needs the database that was down.
set -euo pipefail

mode=notify
if [ "${1:-}" = "--resolve" ]; then
  mode=resolve
  shift
fi
unit=${1:?usage: notify-failure [--resolve] <unit>}
stamp_dir=/run/alerting/failure-notified
stamp="${stamp_dir}/${unit}"
state="${stamp_dir}/${unit}.json"

if [ "$mode" = resolve ] && [ ! -f "$state" ]; then
  # OnSuccess= fires on every successful run of every scheduled unit, so the
  # nothing-to-resolve path must cost nothing: no secrets, no Slack call.
  exit 0
fi

install -d -m 0700 "$stamp_dir"

# load-secrets shells out to the AWS CLI, which needs a writable HOME. Under
# the unit's sandbox there is none, so it fails before fetching anything —
# run-worker sets this up for the same reason.
export HOME=/run/alerting/home
install -d -m 0700 "$HOME"

credentials_path=/run/alerting/notify-failure.env
cleanup() { rm -f "$credentials_path"; }
trap cleanup EXIT HUP INT TERM
/opt/alerting/bin/load-secrets "$credentials_path"
set -a
# Generated from validated Secrets Manager JSON.
# shellcheck disable=SC1091
source /etc/alerting/worker.env
# shellcheck disable=SC1090
source "$credentials_path"
set +a
rm -f "$credentials_path"
trap - EXIT HUP INT TERM

destination=${ALERTING_FAILURE_SLACK_DESTINATION:-${SLACK_CHANNEL_ID:-}}
if [ -z "$destination" ]; then
  echo "ALERTING_FAILURE_SLACK_DESTINATION is not set" >&2
  exit 1
fi

if [ "$mode" = resolve ]; then
  update_payload=/run/alerting/notify-resolve.json
  # Strike the open failure message through in place, mirroring the infra
  # resolve style: Slack mrkdwn strikethrough does not span line breaks, so
  # each plain line is wrapped in ~…~ under a ✅ first line. The error block is
  # left as it was, so the message still says what broke after it recovers.
  /opt/alerting/venv/bin/python - "$state" <<'PY' > "$update_payload"
import json, sys
from datetime import datetime, timezone
with open(sys.argv[1]) as f:
    state = json.load(f)
now = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
lines, fenced = [], False
for line in state["text"].split("\n"):
    fences = line.count("```")
    plain = not fenced and fences == 0 and line.strip()
    lines.append(f"~{line}~" if plain else line)
    fenced ^= fences % 2 == 1
count = int(state.get("count", 1))
header = f":white_check_mark: *Resolved* {now} after {count} failed run{'s' if count != 1 else ''}"
if state.get("since"):
    header += f" since {state['since']}"
print(json.dumps({
    "channel": state["channel"],
    "ts": state["ts"],
    "text": header + "\n" + "\n".join(lines),
}))
PY

  response=$(curl -sS -X POST https://slack.com/api/chat.update \
    -H "Authorization: Bearer ${SLACK_BOT_TOKEN}" \
    -H "Content-type: application/json; charset=utf-8" \
    --data @"$update_payload")

  if [[ "$response" != *'"ok":true'* ]]; then
    # The open message was deleted (or the channel is gone): post the resolve
    # as a fresh message instead, same fallback as the infra resolve path.
    post_payload=/run/alerting/notify-resolve-post.json
    /opt/alerting/venv/bin/python - "$update_payload" <<'PY' > "$post_payload"
import json, sys
with open(sys.argv[1]) as f:
    payload = json.load(f)
payload.pop("ts", None)
print(json.dumps(payload))
PY
    post_response=$(curl -sS -X POST https://slack.com/api/chat.postMessage \
      -H "Authorization: Bearer ${SLACK_BOT_TOKEN}" \
      -H "Content-type: application/json; charset=utf-8" \
      --data @"$post_payload")
    rm -f "$post_payload" "$update_payload"
    if [[ "$post_response" != *'"ok":true'* ]]; then
      echo "Slack rejected the resolve notification: $response; $post_response" >&2
      exit 1
    fi
  else
    rm -f "$update_payload"
  fi

  # The episode is over: the next failure opens a new message.
  rm -f "$state" "$stamp"
  exit 0
fi

# systemd hands an OnFailure= unit the failed run's own result, exit status
# and invocation ID (the MONITOR_* variables, systemd 251+). Live unit state
# cannot be trusted — the next tick resets it, and on 2026-09-16 a failed scan
# was reported as "result success, exit 0" — and the journal is unreadable to
# the alerting user, which is why every message said "no journal record".
result=${MONITOR_SERVICE_RESULT:-unknown}
status=${MONITOR_EXIT_STATUS:-?}
# The worker writes its error here, named by its INVOCATION_ID, because its
# output is discarded and this notifier must not need the database.
failure_file=/run/alerting/failures/${MONITOR_INVOCATION_ID:-none}
find /run/alerting/failures -type f -mmin +1440 -delete 2>/dev/null || true

# One message per failure episode. While one is open, each further failure
# edits it with the latest error and a running count instead of posting
# again, so the resolve that strikes it through covers the whole episode.
payload_path=/run/alerting/notify-failure.json
/opt/alerting/venv/bin/python - "$destination" "$unit" "$result" "$status" "$failure_file" "$state" "$payload_path" <<'PY'
import json, sys
from datetime import datetime, timezone
destination, unit, result, status, failure_file, state_path, payload_path = sys.argv[1:8]
now = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
fence = "`" * 3
try:
    with open(state_path) as f:
        state = json.load(f)
except (OSError, ValueError):
    state = {}
try:
    with open(failure_file) as f:
        run, _, error = f.read().partition("\n")
except OSError:
    run, error = "", ""
run, error = run.strip(), error.strip()
count = int(state.get("count", 0)) + 1
since = state.get("since", now)

text = f":rotating_light: *Alerting worker failure* — `{unit}`\n"
if error:
    text += f"*Error:*\n{fence}{error[-1200:].replace(fence, '')}{fence}\n"
else:
    text += (
        "*Error:* not recorded. The unit failed before the worker could report it "
        "(loading secrets, network, or a crash). On the host, as root: "
        f"`journalctl -u {unit} -n 50`\n"
    )
text += f"*Run:* `{run or 'unknown'}` · result `{result}`, exit `{status}` · {now}\n"
if count > 1:
    text += f"*Failing since* {since} · {count} failed runs\n"
if run:
    text += (
        "*Debug:* `SELECT status, last_error, updated_at FROM "
        f"alerting_automation_executions WHERE idempotency_key = '{run}'`\n"
    )
text += "Runbook: vLLM CI Alerting — Operations Handbook."

payload = {"channel": state.get("channel", destination), "text": text}
if state.get("ts"):
    payload["ts"] = state["ts"]
with open(payload_path, "w") as f:
    json.dump({"payload": payload, "since": since, "count": count}, f)
PY
method=chat.postMessage
if /opt/alerting/venv/bin/python -c 'import json, sys; sys.exit("ts" not in json.load(open(sys.argv[1]))["payload"])' "$payload_path"; then
  method=chat.update
fi

send() {  # send <method>: deliver the payload built above, print Slack's answer
  /opt/alerting/venv/bin/python -c 'import json, sys; print(json.dumps(json.load(open(sys.argv[1]))["payload"]))' "$payload_path" \
    | curl -sS -X POST "https://slack.com/api/$1" \
      -H "Authorization: Bearer ${SLACK_BOT_TOKEN}" \
      -H "Content-type: application/json; charset=utf-8" \
      --data @-
}

response=$(send "$method")
if [ "$method" = chat.update ] && [[ "$response" != *'"ok":true'* ]]; then
  # The open message was deleted: start the episode over with a fresh post.
  /opt/alerting/venv/bin/python - "$payload_path" <<'PY'
import json, sys
with open(sys.argv[1]) as f:
    built = json.load(f)
built["payload"].pop("ts", None)
with open(sys.argv[1], "w") as f:
    json.dump(built, f)
PY
  response=$(send chat.postMessage)
fi

case "$response" in
  *'"ok":true'*)
    # Keep the message's ts, text and episode count so the next failure edits
    # it and `--resolve` strikes it through. /run is tmpfs: a reboot loses
    # this, and the next failure simply opens a new message.
    /opt/alerting/venv/bin/python - "$payload_path" "$response" "$state" <<'PY'
import json, sys
payload_path, response_raw, state_path = sys.argv[1:4]
with open(payload_path) as f:
    built = json.load(f)
response = json.loads(response_raw)
with open(state_path, "w") as f:
    json.dump(
        {
            "ts": response["ts"],
            "channel": response["channel"],
            "text": built["payload"]["text"],
            "since": built["since"],
            "count": built["count"],
        },
        f,
    )
PY
    rm -f "$payload_path" "$failure_file"
    ;;
  *)
    echo "Slack rejected the failure notification: $response" >&2
    rm -f "$payload_path"
    exit 1
    ;;
esac
