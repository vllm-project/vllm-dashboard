# Environment for gpu-reporter.service (bare-metal GPU hosts). Install as
# /etc/gpu-reporter.env with mode 0600, owned by root.
GPU_REPORT_URL=https://vllm-ci-dashboard.vercel.app/api/gpu/report
GPU_REPORT_SECRET=replace-with-the-real-secret
# Optional: override the reported hostname (default: system hostname)
# GPU_HOSTNAME=h200-ci-1
# Read by quarantine-check-host.service too. Optional:
# QUARANTINE_VERIFY_LEVEL=2   # dcgmi diag level; 0 skips the return check
# QUARANTINE_HOST=h200-ci-1   # this host's name in the desired set
