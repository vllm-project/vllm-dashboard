[Unit]
Description=Put an off-worker CloudWatch heartbeat for this cluster's quarantine actuator

[Service]
Type=oneshot
# Per-control-plane static credentials and the heartbeat's job name, root
# 0600 (heartbeat-aws.env.example). Never the worker secret and never the
# reporter env: the alarm path must survive a secret this host cannot load.
# systemd reads EnvironmentFile as PID 1, so the file stays root-only while
# the CLI runs unprivileged.
EnvironmentFile=/etc/gpu-reporter/heartbeat-aws.env
DynamicUser=yes
# HEARTBEAT_JOB is quarantine-actuator-<cluster>, so the same unit file
# serves both control planes.
ExecStart=/opt/gpu-reporter/emit-heartbeat ${HEARTBEAT_JOB}
# The aws CLI needs a writable HOME and this sandbox has none (the worker's
# failure notifier died to exactly this on its first deploy); PrivateTmp,
# implied by DynamicUser, provides /tmp.
Environment=HOME=/tmp
# The only bound on the emit (the CLI retries run inside it).
TimeoutStartSec=30s
StandardOutput=null
# Not inherited from StandardOutput: a heartbeat that fails silently is worse
# than no heartbeat. Its stderr carries no secrets.
StandardError=journal
UMask=0077
# DynamicUser=yes already implies NoNewPrivileges, PrivateTmp,
# ProtectSystem=strict and RestrictSUIDSGID; keep the stricter ProtectHome.
ProtectHome=true
LockPersonality=true
# No failure chaining here: a dead heartbeat is not the actuator failing,
# and the off-host CloudWatch alarm is the thing that notices it.
