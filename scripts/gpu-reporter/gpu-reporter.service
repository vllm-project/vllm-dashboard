[Unit]
Description=Report GPU and host metrics to vLLM Dashboard

[Service]
Type=oneshot
# Copy gpu-reporter.env to /etc/gpu-reporter.env (mode 0600, root) and fill in
# the real values. The secret must never be committed or written into this unit.
EnvironmentFile=/etc/gpu-reporter.env
ExecStart=/usr/bin/python3 /opt/gpu-reporter/gpu-reporter.py
TimeoutSec=30
