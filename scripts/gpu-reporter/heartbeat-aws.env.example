# Environment for quarantine-actuator-heartbeat.service. Install as
# /etc/gpu-reporter/heartbeat-aws.env with mode 0600, owned by root.
# Per-control-plane static credentials whose only permission is
# cloudwatch:PutMetricData in the VllmAlerting namespace (condition key
# cloudwatch:namespace) — never the worker secret, never the reporter
# secret. One IAM user per control plane, so a host's key revokes alone.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# The region the alerting worker stack lives in; the alarms read this
# namespace there.
AWS_DEFAULT_REGION=replace-me
# This cluster's heartbeat identity: quarantine-actuator-<cluster>, matching
# QUARANTINE_CLUSTER in gpu-reporter-k8s.env (h100 or b200).
HEARTBEAT_JOB=quarantine-actuator-h100
