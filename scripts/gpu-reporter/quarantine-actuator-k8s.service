[Unit]
Description=Apply vLLM CI quarantine decisions to the nodes of this cluster
# Off-host heartbeat after each completed poll; a poll that never finishes
# exits 1 and emits nothing, and the CloudWatch alarm on the gap is the only
# pager a control plane has.
OnSuccess=quarantine-actuator-heartbeat.service

[Service]
Type=oneshot
# A completed poll with per-node errors exits 3: count it as success so the
# OnSuccess= heartbeat still fires; only a poll that never finished (exit 1)
# silences it. Not 2: Python and argparse exit 2 on their own failures.
SuccessExitStatus=3
# Same env file as gpu-reporter-k8s.service (GPU_REPORT_URL, GPU_REPORT_SECRET),
# plus QUARANTINE_CLUSTER. The secret must never be written into this unit.
EnvironmentFile=/etc/gpu-reporter/gpu-reporter-k8s.env
# Kubeconfig for the quarantine-actuator ServiceAccount, root-only 0600
# (see quarantine-actuator-k8s-rbac.yaml). Do NOT use /etc/kubernetes/admin.conf.
Environment=KUBECONFIG=/etc/gpu-reporter/quarantine-actuator-k8s.kubeconfig
# Roll out with --dry-run first; drop it once the logged commands look right.
ExecStart=/usr/bin/python3 /opt/gpu-reporter/quarantine-actuator-k8s.py --dry-run
TimeoutSec=120

[Install]
WantedBy=multi-user.target
