# Environment for gpu-reporter-k8s.service. Install as
# /etc/gpu-reporter/gpu-reporter-k8s.env with mode 0600, owned by root.
GPU_REPORT_URL=https://vllm-ci-dashboard.vercel.app/api/gpu/report
GPU_REPORT_SECRET=replace-with-the-real-secret
# Read by quarantine-actuator-k8s.service only: this cluster's name in the
# dashboard's quarantine desired set: h100 or b200, the names the trigger
# rules use.
QUARANTINE_CLUSTER=h100
# The return check before a resolved node goes back (actuator only):
# dcgmi diag run level, 0 to skip, and a DCGM image matching the cluster's
# DCGM version (the dcgm-exporter tag's first part).
QUARANTINE_VERIFY_LEVEL=2
QUARANTINE_VERIFY_IMAGE=nvcr.io/nvidia/cloud-native/dcgm:4.4.2-1-ubuntu22.04
